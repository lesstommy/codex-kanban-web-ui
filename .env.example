SERVER_HOST=127.0.0.1
SERVER_PORT=4317
VITE_HOST=127.0.0.1
VITE_PORT=5173
HARNESS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/harness?replicaSet=rs0
MONGO_DB=harness
CODEX_BIN=codex
# CODEX_WORKSPACE=/absolute/path/to/default/workspace
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL=never
CODEX_TURN_TIMEOUT_MS=0
CODEX_WORKER_CONCURRENCY=5
HARNESS_LOCAL_FILE_MAX_BYTES=26214400
# CODEX_MODEL=
# CODEX_REASONING_EFFORT=
HARNESS_LOCAL_DIR=.local

# 本机回环开发默认不启用登录；设置密码后会自动启用。
# 下面的账号密码用于启动时 seed / 恢复 MongoDB accounts 管理员账户。
# 公网或反向代理暴露前必须启用，并建议使用 HTTPS + Secure Cookie。
# HARNESS_AUTH_ENABLED=true
# HARNESS_AUTH_USERNAME=admin
# HARNESS_AUTH_PASSWORD=
# HARNESS_AUTH_PASSWORD_HASH=
# HARNESS_SESSION_SECRET=
# HARNESS_SESSION_TTL_MS=604800000
# HARNESS_COOKIE_SECURE=false
# HARNESS_LOGIN_MAX_ATTEMPTS=8
# HARNESS_LOGIN_WINDOW_MS=300000

# 可选：为 CLI / 其他 Agent bootstrap 一个 Bearer token。
# 启动时会 upsert 到 MongoDB `service_accounts` 集合。
# HARNESS_API_TOKEN=
# HARNESS_API_TOKEN_NAME=codex-cli
