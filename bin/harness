#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ ! -x "$ROOT_DIR/node_modules/.bin/tsx" ]]; then
  echo "tsx not found. Run: npm install" >&2
  exit 1
fi

exec "$ROOT_DIR/node_modules/.bin/tsx" "$ROOT_DIR/src/cli/index.ts" "$@"
